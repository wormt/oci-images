FROM ubuntu:latest@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944

ARG DEBIAN_FRONTEND=noninteractive

RUN apt update -y && apt upgrade -y \
	; apt install -y \
		systemd \
		python3 \
	; apt clean -y

VOLUME ["/sys/fs/cgroup"]
CMD ["/lib/systemd/systemd"]
