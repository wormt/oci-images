FROM ubuntu:latest@sha256:19fcd1bf268f02b60aca3bd30bd8a6d9a11759a430e32921833e65f16d87348a

ARG DEBIAN_FRONTEND=noninteractive

RUN apt update -y && apt upgrade -y \
	; apt install -y \
		systemd \
		python3 \
	; apt clean -y

VOLUME ["/sys/fs/cgroup"]
CMD ["/lib/systemd/systemd"]
