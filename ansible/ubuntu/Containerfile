FROM ubuntu:latest@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

ARG DEBIAN_FRONTEND=noninteractive

RUN apt update -y && apt upgrade -y \
	; apt install -y \
		systemd \
		python3 \
	; apt clean -y

VOLUME ["/sys/fs/cgroup"]
CMD ["/lib/systemd/systemd"]
