FROM ubuntu:latest@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db

ARG DEBIAN_FRONTEND=noninteractive

RUN apt update -y && apt upgrade -y \
	; apt install -y \
		systemd \
		python3 \
	; apt clean -y

VOLUME ["/sys/fs/cgroup"]
CMD ["/lib/systemd/systemd"]
