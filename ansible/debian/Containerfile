FROM debian:stable@sha256:defb09e17b8c7326f9a3b63ecf0797f34674691f5c270d63987b955ff0168bd8

ARG DEBIAN_FRONTEND=noninteractive

RUN apt update -y && apt upgrade -y \
	; apt install -y \
		systemd-sysv \
		python3 \
	; apt clean -y

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
