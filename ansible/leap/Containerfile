FROM opensuse/leap:latest@sha256:2a2850caec07236eccfe98846f5ed18a67739545620bc5364af1999b4b970665

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
