FROM opensuse/leap:latest@sha256:40b8e1fc290b203380b9adc7cd147ef2141f5a613c7cf7117f678f626855654e

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
