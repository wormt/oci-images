FROM opensuse/leap:latest@sha256:952857883a24c24a64c8bc67d7d1a8f9d4800ad4fbe075fc4566ff9af706cb8b

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
