FROM opensuse/leap:latest@sha256:694ba6edced2678a4bee2842cd2fbf509381331b09772978582901086085f184

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
