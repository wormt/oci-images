FROM opensuse/leap:latest@sha256:966ea44f996aa60bd9ef163067a72cb6cdf5282aa4e91706f4d5a00c5d521bbf

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
