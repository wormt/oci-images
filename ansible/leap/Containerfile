FROM opensuse/leap:latest@sha256:a4115e2f5aea9712a7c73974fd94000a034fc3051ef29b5f7722fbf04070dd9d

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
