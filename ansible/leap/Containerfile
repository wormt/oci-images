FROM opensuse/leap:latest@sha256:20a5ee325f0ece6de4a712d6d4780c7669ef912673646324fc445d2c9536d42b

RUN zypper refresh \
	&& zypper update -y \
	&& zypper install -yt pattern base \
	&& zypper install -y python312 \
	; zypper clean -a

VOLUME ["/sys/fs/cgroup"]
CMD ["/usr/lib/systemd/systemd"]
